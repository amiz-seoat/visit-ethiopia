# Backend example environment file
# Copy this to `config.env` in the backend folder and fill the values before running.

NODE_ENV=development
PORT=5000

# MongoDB connection string (replace with your URI from Atlas → Connect → Drivers)
# Prefer mongodb+srv:// for Atlas, e.g.:
# DATABASE=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/visit-ethiopia?retryWrites=true&w=majority
DATABASE=mongodb://localhost:27017/visit-ethiopia

# Optional: allow API process to stay up when MongoDB is unreachable (local debugging only)
# ALLOW_START_WITHOUT_DB=true

# JWT / Auth
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90

# URLs
# FRONTEND_URL is also used for production CORS (must match the browser origin exactly).
# Optional: CORS_ALLOWED_ORIGINS=https://extra-origin.example.com,https://another.example.com
BACKEND_URL=http://localhost:5000
PROD_BACKEND_URL=https://your-production-backend.example.com
FRONTEND_URL=http://localhost:5173

# Render production notes:
# - Set NODE_ENV=production on the host (do not rely on config.env there).
# - Set FRONTEND_URL to the Render static site origin (no trailing slash).
# - Set BACKEND_URL and PROD_BACKEND_URL to the Render API origin.
# - Keep payment mock: do not set Chapa or other real payment credentials.
# PAYMENT_PROVIDER=mock

# Email (signup verification / password reset)
EMAIL_USER=you@example.com
EMAIL_PASS=your_app_password

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Phase 4 — Tour booking (optional overrides)
# Minutes before payment_pending bookings expire (default: 15)
# BOOKING_PAYMENT_PENDING_MINUTES=15
# Hours before departure when paid bookings can no longer be cancelled (default: 48)
# BOOKING_CANCELLATION_CUTOFF_HOURS=48
# Refund percent outside cutoff window (default: 100)
# BOOKING_REFUND_PERCENT_OUTSIDE_CUTOFF=100
# Refund percent inside cutoff window (default: 0 = non-refundable for customers)
# BOOKING_REFUND_PERCENT_INSIDE_CUTOFF=0

# Phase 4E — Mock webhook verification secret (dev/test only)
# MOCK_WEBHOOK_SECRET=mock-webhook-dev-secret
