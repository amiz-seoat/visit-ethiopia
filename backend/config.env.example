# Visit Ethiopia API — example environment
# Copy to `config.env` (git-ignored) for local development. In production set
# these on the host (Render → Environment); config.env is NOT read when
# NODE_ENV=production. Never commit real values. Full reference:
# docs/ENVIRONMENT_VARIABLES.md

NODE_ENV=development
PORT=4002

# --- Database (PostgreSQL via Prisma — the production source of truth) -----
DATABASE_MODE=prisma
CATALOG_DB=prisma
SKIP_MONGO=true
# Local Docker (docker-compose.prisma.yml, host port 5434):
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/visit_ethiopia?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5434/visit_ethiopia?schema=public
# Neon production: DATABASE_URL = pooled host (-pooler) + &pgbouncer=true&connect_timeout=15
#                  DIRECT_URL   = direct host (used by `prisma migrate deploy`)

# Legacy MongoDB path (only when DATABASE_MODE=mongo; not used in production)
# DATABASE=mongodb://localhost:27017/visit-ethiopia

# --- Auth -------------------------------------------------------------------
# Production requires >= 32 random characters (server refuses to start otherwise).
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# --- Public URLs ------------------------------------------------------------
# FRONTEND_URL: CORS origin + payment return URL + email links (no trailing slash)
FRONTEND_URL=http://localhost:5200
# Extra allowed browser origins, comma-separated (optional)
# CORS_ALLOWED_ORIGINS=https://another-frontend.example.com
# Public API origin used in Chapa callback URLs and verification emails
PUBLIC_BACKEND_URL=http://localhost:4002

# --- Payments ---------------------------------------------------------------
# PAYMENT_PROVIDER=chapa|mock. Default: chapa when CHAPA_SECRET_KEY is set, else mock.
# PAYMENT_PROVIDER=mock
# Chapa TEST keys first (CHASECK_TEST-...). Live keys require explicit owner approval.
# CHAPA_SECRET_KEY=
# Webhook secret configured in the Chapa dashboard (HMAC-SHA256 signature check)
# CHAPA_WEBHOOK_SECRET=
# Demo payments in production (portfolio mode, no real money). Never with live Chapa keys.
# ALLOW_MOCK_PAYMENTS=true
# MOCK_WEBHOOK_SECRET=dev-only-mock-webhook-secret

# Background reconciliation (verify pending Chapa payments, expire stale holds)
RECONCILIATION_INTERVAL_MINUTES=5

# --- Booking policy overrides (optional) --------------------------------------
# BOOKING_PAYMENT_PENDING_MINUTES=15
# BOOKING_CANCELLATION_CUTOFF_HOURS=48
# BOOKING_REFUND_PERCENT_OUTSIDE_CUTOFF=100
# BOOKING_REFUND_PERCENT_INSIDE_CUTOFF=0

# --- Email (verification, password reset, booking confirmation) --------------
# Gmail app password, or generic SMTP via EMAIL_HOST/EMAIL_PORT.
# Without email in production, new accounts are auto-verified (documented limitation).
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_FROM_NAME=Visit Ethiopia

# --- Rate limiting (optional) -----------------------------------------------------
# RATE_LIMIT_MAX=600

# --- Local seeds only (never production) -------------------------------------------
# SEED_LOCAL_PASSWORD=
# Demo marketplace seed (scripts/seedDemoMarketplace.js) — optional accounts:
# ADMIN_EMAIL=        ADMIN_PASSWORD=   (>= 12 chars)
# DEMO_PASSWORD=      (>= 10 chars; creates demo traveler + usable demo provider login)
